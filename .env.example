# CivicPulse Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# === Database ===
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=civicpulse
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}

# === Redis ===
REDIS_URL=redis://cache:6379/0

# === AI Triage ===
# Options: llm, ollama, rules, simulated
TRIAGE_PROVIDER=rules
# Groq API key (required when TRIAGE_PROVIDER=llm)
GROQ_API_KEY=your-groq-api-key-here
# Model to use with Groq
LLM_MODEL=llama-3.1-8b-instant
# Ollama base URL (used when TRIAGE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# === Application ===
BACKEND_PORT=8000
FRONTEND_PORT=80
LOG_LEVEL=INFO

# === Frontend Runtime Config ===
API_BASE_URL=http://localhost:8000
